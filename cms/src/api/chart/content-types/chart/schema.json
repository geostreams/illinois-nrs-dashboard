{
  "kind": "collectionType",
  "collectionName": "charts",
  "info": {
    "singularName": "chart",
    "pluralName": "charts",
    "displayName": "Chart",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "caption": {
      "type": "string"
    },
    "chartType": {
      "type": "enumeration",
      "enum": [
        "filled_pie",
        "stacked_bar",
        "line",
        "bar",
        "table"
      ]
    },
    "chartData": {
      "type": "json"
    },
    "chartColors": {
      "type": "json"
    },
    "miscChartData": {
      "type": "json"
    },
    "altText": {
      "type": "text"
    },
    "dataFile": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "chartID": {
      "type": "uid"
    },
    "currency": {
      "type": "boolean",
      "default": false
    }
  }
}
