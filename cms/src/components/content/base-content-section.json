{
  "collectionName": "components_content_base_content_sections",
  "info": {
    "displayName": "Base Content Section",
    "description": ""
  },
  "options": {},
  "attributes": {
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "textContent": {
      "type": "customField",
      "options": {
        "preset": "defaultHtml"
      },
      "customField": "plugin::ckeditor5.CKEditor"
    },
    "pullQuote": {
      "type": "component",
      "repeatable": false,
      "component": "content.pullquote"
    },
    "quotePlacement": {
      "type": "enumeration",
      "enum": [
        "above",
        "below"
      ]
    }
  }
}
