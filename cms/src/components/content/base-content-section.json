{
  "collectionName": "components_content_base_content_sections",
  "info": {
    "displayName": "Base Content Section",
    "description": ""
  },
  "options": {},
  "attributes": {
    "textContent": {
      "type": "customField",
      "options": {
        "preset": "defaultHtml"
      },
      "customField": "plugin::ckeditor5.CKEditor"
    },
    "pullQuote": {
      "type": "component",
      "repeatable": false,
      "component": "content.pullquote"
    },
    "quotePlacement": {
      "type": "enumeration",
      "enum": [
        "above",
        "below"
      ]
    },
    "borderedTextBox": {
      "type": "boolean",
      "default": false
    },
    "image": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::image.image"
    }
  }
}
