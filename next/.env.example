CMS_URL="https://strapi.illinois-nlrs.ncsa.illinois.edu"
# CMS_URL="http://localhost:1337"
NODE_ENV=""

# Google Analytics – leave blank or remove to disable tracking
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
ELASTICSEARCH_URL="http://elasticsearch:9200"

# Preview – must match PREVIEW_SECRET in cms/.env
PREVIEW_SECRET=tobemodified
# Strapi read-only API token – generate in Strapi admin: Settings > API Tokens
CMS_API_TOKEN=tobemodified
