# Absolute path to the JWT config JSON downloaded from the Box Developer Console
# (App Settings > Configuration > Generate a Public/Private Keypair → downloads a .json file)
BOX_JWT_CONFIG_PATH=/path/to/box_jwt_config.json

# Box folder ID for the backup destination
# To find it: open the folder in Box web → the ID is the number at the end of the URL
# e.g. https://illinois.box.com/folder/123456789 → folder ID is 123456789
# Files > Illinois NRS Resource Dump > CMS Backups
BOX_FOLDER_ID=replace_with_box_folder_id

# Absolute path to the Strapi cms directory on this server
CMS_DIR=/absolute/path/to/illinois-nrs-dashboard/cms
